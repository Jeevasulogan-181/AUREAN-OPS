# Neon serverless Postgres connection string
# Get this from your Neon project dashboard (use the pooled connection string).
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.region.aws.neon.tech/dbname?sslmode=require

# Seed script — used once to create the first (superadmin) user.
# Change SUPERADMIN_PASSWORD after first login isn't required for this account,
# so pick a strong password here.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-please-1234
SUPERADMIN_EMAIL=admin@yourcompany.com
